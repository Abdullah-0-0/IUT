<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             version="3.0">

    <persistence-unit name="myPersistenceUnit">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>iut.nantes.hibernate.entities.Product</class>
<!--
        <class>iut.nantes.hibernate.entities.onetomany.Product</class>
        <class>iut.nantes.hibernate.entities.onetomany.User</class>

        <class>iut.nantes.hibernate.entities.manytomany.Product</class>
        <class>iut.nantes.hibernate.entities.manytomany.User</class>

        <class>iut.nantes.hibernate.entities.manytomanywithparameter.Product</class>
        <class>iut.nantes.hibernate.entities.manytomanywithparameter.User</class>
        <class>iut.nantes.hibernate.entities.manytomanywithparameter.UserProduct</class>

-->
        <properties>
            <property name="jakarta.persistence.jdbc.driver"
                      value="org.h2.Driver"/>
            <property name="hibernate.dialect" value="org.hibernate.dialect.H2Dialect"/>
            <!-- Travail sur disque
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:h2:~/test"/>
                      -->
            <property name="jakarta.persistence.jdbc.url"
                      value="jdbc:h2:mem:test"/>
            <property name="jakarta.persistence.jdbc.user"
                      value="sa"/>
            <property name="jakarta.persistence.jdbc.password"
                      value=""/>

            <property name="hibernate.hbm2ddl.auto"
                      value="update"/>
            <property name="hibernate.show_sql"
                      value="true"/>
            <property name="show_sql" value="true" />
            <property name="format_sql" value="true" />
        </properties>

    </persistence-unit>
</persistence>
