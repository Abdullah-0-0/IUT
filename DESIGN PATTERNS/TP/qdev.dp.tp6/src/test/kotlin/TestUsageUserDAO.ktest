import netprime.datalayer.UserDAO
import netprime.datalayer.datamodel.users.*
import netprime.datalayer.iUserDAO
import netprime.exceptions.JsonParserException
import netprime.exceptions.UserException
import org.junit.jupiter.api.Assertions.*
import org.junit.jupiter.api.BeforeEach
import org.junit.jupiter.api.Test
import org.junit.jupiter.api.assertThrows
import java.io.FileNotFoundException

class TestUsageUserDAO {

    lateinit var users: Set<User>
    lateinit var userDAO: iUserDAO

    @BeforeEach
    fun reinit() {
        users = setOf()
        userDAO = UserDAO()
    }

    @Test
    fun test0user() {
        assertEquals(0, users.size)
    }

    @Test
    fun testFileNotFoundExceptionUser() {
        assertThrows<FileNotFoundException> { userDAO.addFrom("data/users/XXX.json") }
    }

    @Test
    fun testJSonParserExceptionUser() {
        assertThrows<JsonParserException> { userDAO.addFrom("data/series/4_series.json") }
    }

    @Test
    fun testJSonParserExceptionYuser() {
        assertThrows<JsonParserException> { userDAO.addFrom("data/movies/IMDb.md") }
    }

    @Test
    fun test1user() {
        users = userDAO.addFrom("data/users/1_users.json")
        assertEquals(1, users.size)
    }

    @Test
    fun test3user() {
        users = userDAO.addFrom("data/users/1_users.json")
        assertEquals(1, users.size)
        users = userDAO.addFrom("data/users/2_users.json")
        assertEquals(3, users.size)
    }

    @Test
    fun test4userWithDoublon() {
        assertThrows<UserException> { userDAO.addFrom("data/users/4_users_with2same.json") }
    }

    @Test
    fun test82user() {
        users = userDAO.addFrom("data/users/2_users.json")
        users = userDAO.addFrom("data/users/80_users.json")
        assertEquals(82, users.size)
    }


    @Test
    fun test83user() {
        users = userDAO.addFrom("data/users/1_users.json")
        users = userDAO.addFrom("data/users/2_users.json")
        assertThrows<UserException> { userDAO.addFrom("data/users/80_users.json") }
    }

    @Test
    fun testList2User() {
        users = userDAO.addFrom("data/users/2_users.json")
        assertTrue(users.contains(amanda))
        assertTrue(users.contains(lisa))
    }

    @Test
    fun testContains1user() {
        users = userDAO.addFrom("data/users/1_users.json")
        assertTrue(users.contains(raphael))
        assertEquals(raphael, users.first())
    }

    @Test
    fun testContains80user() {
        users = userDAO.addFrom("data/users/80_users.json")
        assertTrue(users.contains(raphael))
    }

    @Test
    fun testContains2user() {

        users = userDAO.addFrom("data/users/2_users.json")
        assertFalse(users.contains(raphael))
    }

    // ---- contenu des ensembles retournés ----

    @Test
    fun testListIs1UserExactly() {
        users = userDAO.addFrom("data/users/1_users.json")
        assertEquals(setOf(raphael), users)
    }

    @Test
    fun testList2UserExactly() {
        users = userDAO.addFrom("data/users/2_users.json")
        assertEquals(setOf(amanda, lisa), users)
    }

    @Test
    fun testResultIsCumulative() {
        userDAO.addFrom("data/users/1_users.json")
        users = userDAO.addFrom("data/users/2_users.json")
        assertEquals(setOf(raphael, amanda, lisa), users)
    }

    @Test
    fun testList80UserContent() {
        users = userDAO.addFrom("data/users/80_users.json")

        assertEquals(80, users.size)
        assertEquals(80, users.map { it.email }.toSet().size)
        assertEquals(44, users.count { it.gender == GENDER.male })
        assertEquals(36, users.count { it.gender == GENDER.female })
        assertEquals(41, users.count { it.nat == NAT.GB })
        assertEquals(39, users.count { it.nat == NAT.FR })
        assertFalse(users.contains(amanda))
        assertFalse(users.contains(lisa))
    }

    @Test
    fun testFirstAndLastOf80User() {
        users = userDAO.addFrom("data/users/80_users.json")

        val vernon = User(
            GENDER.male, Name("Vernon", "Smith"), "vernon.smith@example.com",
            Login("tinyladybug812", "trisha"), NAT.GB
        )
        val oceane = User(
            GENDER.female, Name("Océane", "Leroux"), "oceane.leroux@example.com",
            Login("sadpeacock531", "joecool"), NAT.FR
        )
        assertTrue(users.contains(vernon))
        assertTrue(users.contains(oceane))
    }

    // ---- doublons ----

    @Test
    fun testSameFileTwice() {
        userDAO.addFrom("data/users/2_users.json")
        assertThrows<UserException> { userDAO.addFrom("data/users/2_users.json") }
    }

    @Test
    fun testDoublonInsideOneFile() {
        val e = assertThrows<UserException> { userDAO.addFrom("data/users/4_users_with2same.json") }
        assertNotNull(e.message)
    }

    @Test
    fun testDoublonAddsNothing() {
        userDAO.addFrom("data/users/2_users.json")
        // 4_users_with2same contient lisa, amanda (déjà chargées), raphael et amanda
        assertThrows<UserException> { userDAO.addFrom("data/users/4_users_with2same.json") }
        users = userDAO.addFrom("data/users/1_users.json")
        assertEquals(setOf(amanda, lisa, raphael), users)
    }

    @Test
    fun testDoublonInsideOneFileAddsNothing() {
        assertThrows<UserException> { userDAO.addFrom("data/users/4_users_with2same.json") }
        users = userDAO.addFrom("data/users/1_users.json")
        assertEquals(setOf(raphael), users)
    }

    @Test
    fun testTwoDAOsAreIndependent() {
        val other: iUserDAO = UserDAO()
        userDAO.addFrom("data/users/2_users.json")
        users = other.addFrom("data/users/2_users.json")
        assertEquals(2, users.size)
    }

    // ---- erreurs sur le fichier ----

    @Test
    fun testFailureKeepsPreviousUsers() {
        userDAO.addFrom("data/users/1_users.json")
        assertThrows<FileNotFoundException> { userDAO.addFrom("data/users/XXX.json") }
        assertThrows<JsonParserException> { userDAO.addFrom("data/series/4_series.json") }
        users = userDAO.addFrom("data/users/2_users.json")
        assertEquals(3, users.size)
    }

    @Test
    fun testDirectoryInsteadOfFile() {
        assertThrows<FileNotFoundException> { userDAO.addFrom("data/users") }
    }

    @Test
    fun testEmptyPath() {
        assertThrows<FileNotFoundException> { userDAO.addFrom("") }
    }

    @Test
    fun testEmptyJsonArray() {
        users = userDAO.addFrom("data/empty_array.json")
        assertTrue(users.isEmpty())
    }

    @Test
    fun testEmptyFile() {
        assertThrows<JsonParserException> { userDAO.addFrom("data/empty_file.json") }
    }

    @Test
    fun testJsonObjectInsteadOfArray() {
        assertThrows<JsonParserException> { userDAO.addFrom("data/truc.json") }
    }

    @Test
    fun testArrayOfOtherObjects() {
        assertThrows<JsonParserException> { userDAO.addFrom("data/trucs.json") }
    }

    @Test
    fun testTruncatedJson() {
        assertThrows<JsonParserException> { userDAO.addFrom("data/truncated.json") }
    }

    @Test
    fun testMissingField() {
        assertThrows<JsonParserException> { userDAO.addFrom("data/users/1_user_without_login.json") }
    }

    @Test
    fun testUnknownNat() {
        assertThrows<JsonParserException> { userDAO.addFrom("data/users/1_user_unknown_nat.json") }
    }

    @Test
    fun testUnknownGender() {
        assertThrows<JsonParserException> { userDAO.addFrom("data/users/1_user_unknown_gender.json") }
    }
}

val amanda = User(
    GENDER.female,
    Name("Amanda", "Gomez"),
    "amanda.gomez@example.com",
    Login("yellowzebra428", "barbara"),
    NAT.GB
)

val lisa = User(
    GENDER.female,
    Name("Lisa", "Johnson"),
    "lisa.johnson@example.com",
    Login("yellowelephant638", "navy"),
    NAT.GB
)

val raphael = User(
    GENDER.male,
    Name("Rafael", "Gordon"),
    "rafael.gordon@example.com",
    Login("crazysnake563", "arsenal"),
    NAT.GB
)