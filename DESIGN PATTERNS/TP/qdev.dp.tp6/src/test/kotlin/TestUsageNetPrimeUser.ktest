import netprime.businesslayer.NetPrime
import netprime.businesslayer.iUserRepository
import netprime.datalayer.MediaDAO
import netprime.datalayer.UserDAO
import netprime.datalayer.datamodel.medias.Episode
import netprime.datalayer.datamodel.medias.Media
import netprime.datalayer.datamodel.medias.Movie
import netprime.datalayer.datamodel.medias.Serie
import netprime.datalayer.datamodel.users.*
import netprime.datalayer.iUserDAO
import netprime.exceptions.JsonParserException
import netprime.exceptions.UserException
import org.junit.jupiter.api.Assertions.*
import org.junit.jupiter.api.BeforeEach
import org.junit.jupiter.api.Test
import org.junit.jupiter.api.assertThrows
import java.io.FileNotFoundException

class TestUsageNetPrimeUser {
    
    lateinit var netPrime: iUserRepository

    @BeforeEach
    fun reinit() {
        netPrime = NetPrime(UserDAO(), MediaDAO())
    }


    @Test
    fun test0user() {
        assertEquals(0, netPrime.nbUsers())
    }

    @Test
    fun testFileNotFoundExceptionUser() {
        assertThrows<FileNotFoundException> { netPrime.loadUsersFrom("data/users/XXX.json") }
    }

    @Test
    fun testJSonParserExceptionUser() {
        assertThrows<JsonParserException> { netPrime.loadUsersFrom("data/series/4_series.json") }
    }

    @Test
    fun testJSonParserExceptionYuser() {
        assertThrows<JsonParserException> { netPrime.loadUsersFrom("data/movies/IMDb.md") }
    }

    @Test
    fun test4userWithDoublon() {
        assertThrows<UserException> { netPrime.loadUsersFrom("data/users/4_users_with2same.json") }
    }



    @Test
    fun test1user() {
        netPrime.loadUsersFrom("data/users/1_users.json")
        assertEquals(1, netPrime.nbUsers())
    }

    @Test
    fun test3user() {
        netPrime.loadUsersFrom("data/users/1_users.json")
        assertEquals(1, netPrime.nbUsers())
        netPrime.loadUsersFrom("data/users/2_users.json")
        assertEquals(3, netPrime.nbUsers())
    }


    @Test
    fun test82user() {
        netPrime.loadUsersFrom("data/users/2_users.json")
        netPrime.loadUsersFrom("data/users/80_users.json")
        assertEquals(82, netPrime.nbUsers())
    }


    @Test
    fun testListByNat1User() {
        netPrime.loadUsersFrom("data/users/1_users.json")

        var result = netPrime.listByNat(NAT.FR)
        assertTrue(result.isEmpty())

        result = netPrime.listByNat(NAT.GB)
        assertEquals(1, result.size)
        assertEquals(raphael, result[0])
    }

    @Test
    fun testListByNat2User() {

        netPrime.loadUsersFrom("data/users/2_users.json")

        var result = netPrime.listByNat(NAT.FR)
        assertTrue(result.isEmpty())

        result = netPrime.listByNat(NAT.GB)
        assertEquals(2, result.size)
        assertEquals("amanda.gomez@example.com", result[0].email)
        assertEquals("lisa.johnson@example.com", result[1].email)
        assertTrue(result.contains(amanda))
        assertTrue(result.contains(lisa))
    }


