    @Test
    fun testContains1user() {
        netPrime.loadUsersFrom("data/users/1_users.json")
        assertTrue(netPrime.contains(raphael))
    }

    @Test
    fun testContains80user() {
        netPrime.loadUsersFrom("data/users/80_users.json")
        assertTrue(netPrime.contains(raphael))
    }

    @Test
    fun testContains2user() {
        netPrime.loadUsersFrom("data/users/2_users.json")
        assertFalse(netPrime.contains(raphael))
    }


    @Test
    fun testDeleteUser() {
        netPrime.loadUsersFrom("data/users/80_users.json")
        assertEquals(80, netPrime.nbUsers())
        assertTrue(netPrime.contains(raphael))

        netPrime.deleteByEmail("rafael.gordon@example.com")
        assertEquals(79, netPrime.nbUsers())
        assertFalse(netPrime.contains(raphael))
    }

    @Test
    fun deleteUserNotFound() {
        netPrime.loadUsersFrom("data/users/80_users.json")
        assertEquals(80, netPrime.nbUsers())

        assertThrows<UserException> {
            netPrime.deleteByEmail("xxxxx.xxxx@example.com")
        }
        assertEquals(80, netPrime.nbUsers())
    }

    // ---- chargement : cas limites ----

    @Test
    fun testLoadSameFileTwice() {
        netPrime.loadUsersFrom("data/users/2_users.json")
        assertThrows<UserException> { netPrime.loadUsersFrom("data/users/2_users.json") }
        assertEquals(2, netPrime.nbUsers())
    }

    @Test
    fun testLoadWithDoublonKeepsRepositoryUnchanged() {
        netPrime.loadUsersFrom("data/users/2_users.json")
        assertThrows<UserException> { netPrime.loadUsersFrom("data/users/4_users_with2same.json") }
        assertEquals(2, netPrime.nbUsers())
    }

    @Test
    fun testLoadFailureKeepsRepositoryUnchanged() {
        netPrime.loadUsersFrom("data/users/1_users.json")
        assertThrows<FileNotFoundException> { netPrime.loadUsersFrom("data/users/XXX.json") }
        assertThrows<JsonParserException> { netPrime.loadUsersFrom("data/series/4_series.json") }
        assertEquals(1, netPrime.nbUsers())
        assertTrue(netPrime.contains(raphael))
    }

    // ---- listByNat : cas complémentaires ----

    @Test
    fun testListByNatEmptyRepository() {
        assertTrue(netPrime.listByNat(NAT.FR).isEmpty())
        assertTrue(netPrime.listByNat(NAT.GB).isEmpty())
    }

    @Test
    fun testListByNatFR80User() {
        netPrime.loadUsersFrom("data/users/80_users.json")

        val result = netPrime.listByNat(NAT.FR)
        assertEquals(39, result.size)
        assertTrue(result.all { it.nat == NAT.FR })
        assertEquals("alexia.lemaire@example.com", result.first().email)
        assertEquals("sandro.lambert@example.com", result.last().email)
        assertEquals(result.map { it.email }.sorted(), result.map { it.email })
    }

    @Test
    fun testListByNatPartitionsAllUsers() {
        netPrime.loadUsersFrom("data/users/80_users.json")
        assertEquals(
            netPrime.nbUsers(),
            netPrime.listByNat(NAT.FR).size + netPrime.listByNat(NAT.GB).size
        )
    }

    // ---- contains / delete : cas complémentaires ----

    @Test
    fun testContainsEmptyRepository() {
        assertFalse(netPrime.contains(raphael))
    }

    @Test
    fun testContainsAfterLoadingSeveralFiles() {
        netPrime.loadUsersFrom("data/users/1_users.json")
        netPrime.loadUsersFrom("data/users/2_users.json")
        assertTrue(netPrime.contains(raphael))
        assertTrue(netPrime.contains(amanda))
        assertTrue(netPrime.contains(lisa))
    }

    @Test
    fun testDeleteEmptyRepository() {
        assertThrows<UserException> { netPrime.deleteByEmail("rafael.gordon@example.com") }
        assertEquals(0, netPrime.nbUsers())
    }

    @Test
    fun testDeleteTwiceSameUser() {
        netPrime.loadUsersFrom("data/users/80_users.json")
        netPrime.deleteByEmail("rafael.gordon@example.com")
        assertThrows<UserException> { netPrime.deleteByEmail("rafael.gordon@example.com") }
        assertEquals(79, netPrime.nbUsers())
    }

    @Test
    fun testDeleteKeepsOtherUsers() {
        netPrime.loadUsersFrom("data/users/1_users.json")
        netPrime.loadUsersFrom("data/users/2_users.json")
        netPrime.deleteByEmail("lisa.johnson@example.com")

        assertEquals(2, netPrime.nbUsers())
        assertFalse(netPrime.contains(lisa))
        assertTrue(netPrime.contains(amanda))
        assertTrue(netPrime.contains(raphael))
    }

    @Test
    fun testDeleteIsCaseSensitive() {
        netPrime.loadUsersFrom("data/users/1_users.json")
        assertThrows<UserException> { netPrime.deleteByEmail("RAFAEL.GORDON@EXAMPLE.COM") }
        assertEquals(1, netPrime.nbUsers())
    }

    @Test
    fun testDeleteUpdatesListByNat() {
        netPrime.loadUsersFrom("data/users/2_users.json")
        netPrime.deleteByEmail("amanda.gomez@example.com")

        val result = netPrime.listByNat(NAT.GB)
        assertEquals(1, result.size)
        assertEquals(lisa, result[0])
    }

    @Test
    fun testDeleteUpdatesListByGenderAndFirstname() {
        netPrime.loadUsersFrom("data/users/80_users.json")
        netPrime.deleteByEmail("rafael.gordon@example.com")

        assertFalse(netPrime.listByGender(GENDER.male).contains(Name("Rafael", "Gordon")))
        assertEquals(1, netPrime.listByFirstname("Rafael").size)
        assertThrows<UserException> { netPrime.giveLogin(Name("Rafael", "Gordon")) }
    }

    @Test
    fun testListByGenderEmpty() {
        assertTrue(netPrime.listByGender(GENDER.male).isEmpty())
        assertTrue(netPrime.listByGender(GENDER.female).isEmpty())
    }

    @Test
    fun testListByGender2User() {
        netPrime.loadUsersFrom("data/users/2_users.json")

        assertTrue(netPrime.listByGender(GENDER.male).isEmpty())

        val result = netPrime.listByGender(GENDER.female)
        assertEquals(2, result.size)
        assertEquals(Name("Amanda", "Gomez"), result[0])
        assertEquals(Name("Lisa", "Johnson"), result[1])
    }

    @Test
    fun testListByGender80User() {
        netPrime.loadUsersFrom("data/users/80_users.json")

        val males = netPrime.listByGender(GENDER.male)
        val females = netPrime.listByGender(GENDER.female)
        assertEquals(44, males.size)
        assertEquals(36, females.size)

        assertEquals("Brunet", males.first().last)
        assertEquals("Wright", males.last().last)
        assertEquals(Name("Vicky", "Alvarez"), females.first())
        assertEquals(Name("Heather", "Washington"), females.last())
        assertEquals(males.map { it.last }.sorted(), males.map { it.last })
        assertEquals(females.map { it.last }.sorted(), females.map { it.last })
    }

    @Test
    fun testListByFirstnameNotFound() {
        netPrime.loadUsersFrom("data/users/80_users.json")
        assertTrue(netPrime.listByFirstname("Xxxxx").isEmpty())
    }

    @Test
    fun testListByFirstnameOne() {
        netPrime.loadUsersFrom("data/users/80_users.json")

        val result = netPrime.listByFirstname("Rafael")
        assertEquals(2, result.size)
        assertEquals(Login("happymeercat459", "birdman"), result[0]) // Dumas
        assertEquals(Login("crazysnake563", "arsenal"), result[1])   // Gordon
    }

    @Test
    fun testListByFirstnameSeveral() {
        netPrime.loadUsersFrom("data/users/80_users.json")

        val result = netPrime.listByFirstname("Océane")
        assertEquals(4, result.size)
        assertEquals(
            listOf("silvergoose690", "smallrabbit740", "lazybird699", "sadpeacock531"),
            result.map { it.username }
        ) // Barbier, Guillot, Lefevre, Leroux
    }

    @Test
    fun testListByFirstnameEmptyRepository() {
        assertTrue(netPrime.listByFirstname("Rafael").isEmpty())
    }

    @Test
    fun testContainsByLastname() {
        netPrime.loadUsersFrom("data/users/80_users.json")
        assertTrue(netPrime.containsByLastname("Gordon"))
        assertTrue(netPrime.containsByLastname("Horton")) // plusieurs utilisateurs
        assertFalse(netPrime.containsByLastname("Xxxxx"))
        assertFalse(netPrime.containsByLastname("gordon")) // sensible à la casse
    }

    @Test
    fun testContainsByLastnameEmptyRepository() {
        assertFalse(netPrime.containsByLastname("Gordon"))
    }

    @Test
    fun testContainsByLastnameAfterDelete() {
        netPrime.loadUsersFrom("data/users/80_users.json")
        assertTrue(netPrime.containsByLastname("Gordon"))
        netPrime.deleteByEmail("rafael.gordon@example.com")
        assertFalse(netPrime.containsByLastname("Gordon"))
    }

    @Test
    fun testGiveLogin() {
        netPrime.loadUsersFrom("data/users/80_users.json")
        assertEquals("crazysnake563" to "arsenal", netPrime.giveLogin(Name("Rafael", "Gordon")))
        assertEquals("goldenkoala519" to "zach", netPrime.giveLogin(Name("Nathaniel", "Williamson")))
    }

    @Test
    fun testGiveLoginNotFound() {
        netPrime.loadUsersFrom("data/users/80_users.json")
        assertThrows<UserException> { netPrime.giveLogin(Name("Xxxxx", "Xxxxx")) }
    }

    @Test
    fun testGiveLoginEmptyRepository() {
        assertThrows<UserException> { netPrime.giveLogin(Name("Rafael", "Gordon")) }
    }

    @Test
    fun testGiveLogin1User() {
        netPrime.loadUsersFrom("data/users/1_users.json")
        assertEquals("crazysnake563" to "arsenal", netPrime.giveLogin(Name("Rafael", "Gordon")))
    }

}