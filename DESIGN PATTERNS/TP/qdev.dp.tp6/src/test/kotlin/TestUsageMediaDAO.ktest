import netprime.datalayer.MediaDAO
import netprime.datalayer.datamodel.medias.Episode
import netprime.datalayer.datamodel.medias.Movie
import netprime.datalayer.datamodel.medias.Serie
import netprime.datalayer.iMediaDAO
import netprime.exceptions.EpisodeException
import netprime.exceptions.JsonParserException
import netprime.exceptions.MediaException
import org.junit.jupiter.api.Assertions.*
import org.junit.jupiter.api.BeforeEach
import org.junit.jupiter.api.Test
import org.junit.jupiter.api.assertThrows
import java.io.FileNotFoundException

class TestUsageMediaDAO {

    lateinit var mediaDAO: iMediaDAO

    @BeforeEach
    fun reinit() {
        mediaDAO = MediaDAO()
    }

    // ---- séries ----

    @Test
    fun test1serie() {
        val series = mediaDAO.addSeriesFrom("data/series/1_serie_with_episode.json")
        assertEquals(1, series.size)
        assertEquals(
            Serie("tt7366338", "Chernobyl", 2019, "Jessie Buckley, Jared Harris", 9.3),
            series[0]
        )
    }

    @Test
    fun test4series() {
        val series = mediaDAO.addSeriesFrom("data/series/4_series.json")
        assertEquals(4, series.size)
        assertEquals(
            listOf("Breaking Bad", "Chernobyl", "The Wire", "The Sopranos"),
            series.map { it.title }
        )
        assertEquals(
            listOf("tt0903747", "tt7366338", "tt0306414", "tt0141842"),
            series.map { it.id }
        )
    }

    @Test
    fun testSerieAttributes() {
        val series = mediaDAO.addSeriesFrom("data/series/2_series_without_episode.json")
        val breakingBad = series[0]
        assertEquals("tt0903747", breakingBad.id)
        assertEquals("Breaking Bad", breakingBad.title)
        assertEquals(2008, breakingBad.year)
        assertEquals("Bryan Cranston, Aaron Paul", breakingBad.crew)
        assertEquals(9.4, breakingBad.imDbRating)
        assertTrue(breakingBad.episodes.isEmpty())
    }

    @Test
    fun test250series() {
        val series = mediaDAO.addSeriesFrom("data/series/250_series.json")
        assertEquals(250, series.size)
        assertEquals("Planet Earth II", series[0].title)
        assertEquals(250, series.map { it.id }.toSet().size)
    }

    @Test
    fun testSeriesAreCumulative() {
        mediaDAO.addSeriesFrom("data/series/2_series_without_episode.json")
        val series = mediaDAO.addSeriesFrom("data/series/1_serie_with_episode.json")
        assertEquals(3, series.size)
        assertEquals(listOf("Breaking Bad", "The Wire", "Chernobyl"), series.map { it.title })
    }

    // ---- films ----

    @Test
    fun test250movies() {
        val movies = mediaDAO.addMoviesFrom("data/movies/250_movies.json")
        assertEquals(250, movies.size)
        assertEquals(250, movies.map { it.title }.toSet().size)
    }

    @Test
    fun testMovieAttributes() {
        val movies = mediaDAO.addMoviesFrom("data/movies/250_movies.json")
        assertEquals(
            Movie("The Shawshank Redemption", 1994, "Frank Darabont (dir.), Tim Robbins, Morgan Freeman", 9.2),
            movies[0]
        )
        assertEquals("The Godfather", movies[1].title)
        assertEquals(1972, movies[1].year)
        assertEquals(9.2, movies[1].imDbRating)
    }

    @Test
    fun testMoviesAndSeriesAreSeparate() {
        val movies = mediaDAO.addMoviesFrom("data/movies/250_movies.json")
        val series = mediaDAO.addSeriesFrom("data/series/4_series.json")
        assertEquals(250, movies.size)
        assertEquals(4, series.size)
    }

    // ---- épisodes ----

    @Test
    fun test5episodes() {
        mediaDAO.addSeriesFrom("data/series/1_serie_with_episode.json")
        val episodes = mediaDAO.addEpisodesFrom("data/series/episodes_from_1_serie.json")

        assertEquals(5, episodes.size)
        assertTrue(episodes.all { it.serieId == "tt7366338" })
        assertEquals(
            listOf("1:23:45", "Please Remain Calm", "Open Wide, O Earth", "The Happiness of All Mankind", "Vichnaya Pamyat"),
            episodes.map { it.title }
        )
    }

    @Test
    fun testEpisodeAttributes() {
        mediaDAO.addSeriesFrom("data/series/1_serie_with_episode.json")
        val episodes = mediaDAO.addEpisodesFrom("data/series/episodes_from_1_serie.json")

        assertEquals(Episode("tt7366338", "1:23:45", 2019, 9.4, 1, 1), episodes[0])
        assertEquals(Episode("tt7366338", "Vichnaya Pamyat", 2019, 9.8, 1, 5), episodes[4])
        assertEquals((1..5).toList(), episodes.map { it.episodeNumber })
    }

    @Test
    fun testEpisodesWithSeveralSeriesLoaded() {
        mediaDAO.addSeriesFrom("data/series/4_series.json")
        val episodes = mediaDAO.addEpisodesFrom("data/series/episodes_from_1_serie.json")
        assertEquals(5, episodes.size)
    }

    @Test
    fun testEpisodesWithSeriesLoadedInTwoSteps() {
        mediaDAO.addSeriesFrom("data/series/2_series_without_episode.json")
        mediaDAO.addSeriesFrom("data/series/1_serie_with_episode.json")
        val episodes = mediaDAO.addEpisodesFrom("data/series/episodes_from_1_serie.json")
        assertEquals(5, episodes.size)
    }

    // ---- erreurs ----

    @Test
    fun testFileNotFound() {
        assertThrows<FileNotFoundException> { mediaDAO.addSeriesFrom("data/series/XXX.json") }
        assertThrows<FileNotFoundException> { mediaDAO.addMoviesFrom("data/movies/XXX.json") }
        assertThrows<FileNotFoundException> { mediaDAO.addEpisodesFrom("data/series/XXX.json") }
    }

    @Test
    fun testJsonParserException() {
        assertThrows<JsonParserException> { mediaDAO.addSeriesFrom("data/movies/IMDb.md") }
        assertThrows<JsonParserException> { mediaDAO.addMoviesFrom("data/movies/IMDb.md") }
        assertThrows<JsonParserException> { mediaDAO.addEpisodesFrom("data/movies/IMDb.md") }
    }

    @Test
    fun testEpisodesWithoutSerie() {
        assertThrows<EpisodeException> { mediaDAO.addEpisodesFrom("data/series/episodes_from_1_serie.json") }
    }

    @Test
    fun testEpisodesWithWrongSerie() {
        mediaDAO.addSeriesFrom("data/series/2_series_without_episode.json")
        assertThrows<EpisodeException> { mediaDAO.addEpisodesFrom("data/series/episodes_from_1_serie.json") }
    }

    @Test
    fun testFailureKeepsPreviousMedias() {
        mediaDAO.addSeriesFrom("data/series/1_serie_with_episode.json")
        assertThrows<FileNotFoundException> { mediaDAO.addSeriesFrom("data/series/XXX.json") }
        assertThrows<JsonParserException> { mediaDAO.addSeriesFrom("data/movies/IMDb.md") }
        assertEquals(1, mediaDAO.addSeriesFrom("data/series/2_series_without_episode.json").size - 2)
    }

    @Test
    fun testEpisodesAreSeparateFromSeries() {
        mediaDAO.addSeriesFrom("data/series/1_serie_with_episode.json")
        mediaDAO.addEpisodesFrom("data/series/episodes_from_1_serie.json")
        val series = mediaDAO.addSeriesFrom("data/series/2_series_without_episode.json")
        assertEquals(3, series.size)
    }

    // ---- cumul films / épisodes ----

    @Test
    fun testMoviesAreCumulative() {
        assertEquals(2, mediaDAO.addMoviesFrom("data/movies/2_movies.json").size)
        val movies = mediaDAO.addMoviesFrom("data/movies/1_movie.json")
        assertEquals(listOf("Movie A", "Movie B", "Movie A"), movies.map { it.title })
    }

    @Test
    fun testEpisodesAreCumulative() {
        mediaDAO.addSeriesFrom("data/series/4_series.json")

        assertEquals(5, mediaDAO.addEpisodesFrom("data/series/episodes_from_1_serie.json").size)
        val episodes = mediaDAO.addEpisodesFrom("data/series/episodes_from_other_serie.json")
        assertEquals(7, episodes.size)
        assertEquals(listOf("tt7366338", "tt0141842"), episodes.map { it.serieId }.distinct())
    }

    // ---- atomicité de addEpisodesFrom ----

    @Test
    fun testEpisodesFileWithOneUnknownSerieAddsNothing() {
        val series = mediaDAO.addSeriesFrom("data/series/1_serie_with_episode.json")

        assertThrows<EpisodeException> { mediaDAO.addEpisodesFrom("data/series/episodes_with_unknown_serie.json") }
        assertTrue(series[0].episodes.isEmpty())
        assertEquals(5, mediaDAO.addEpisodesFrom("data/series/episodes_from_1_serie.json").size)
    }

    // ---- JSON mal formé ou particulier ----

    @Test
    fun testEmptyJsonArrays() {
        assertTrue(mediaDAO.addSeriesFrom("data/empty_array.json").isEmpty())
        assertTrue(mediaDAO.addMoviesFrom("data/empty_array.json").isEmpty())
        assertTrue(mediaDAO.addEpisodesFrom("data/empty_array.json").isEmpty())
    }

    @Test
    fun testEmptyFile() {
        assertThrows<JsonParserException> { mediaDAO.addSeriesFrom("data/empty_file.json") }
        assertThrows<JsonParserException> { mediaDAO.addMoviesFrom("data/empty_file.json") }
        assertThrows<JsonParserException> { mediaDAO.addEpisodesFrom("data/empty_file.json") }
    }

    @Test
    fun testJsonObjectInsteadOfArray() {
        assertThrows<JsonParserException> { mediaDAO.addMoviesFrom("data/truc.json") }
    }

    @Test
    fun testArrayOfOtherObjects() {
        assertThrows<JsonParserException> { mediaDAO.addSeriesFrom("data/trucs.json") }
        assertThrows<JsonParserException> { mediaDAO.addMoviesFrom("data/trucs.json") }
        assertThrows<JsonParserException> { mediaDAO.addEpisodesFrom("data/trucs.json") }
    }

    @Test
    fun testTruncatedJson() {
        assertThrows<JsonParserException> { mediaDAO.addMoviesFrom("data/truncated.json") }
    }

    @Test
    fun testMissingField() {
        assertThrows<JsonParserException> { mediaDAO.addMoviesFrom("data/movies/1_movie_without_rating.json") }
    }

    @Test
    fun testNonNumericYear() {
        assertThrows<JsonParserException> { mediaDAO.addMoviesFrom("data/movies/1_movie_with_bad_year.json") }
    }

    @Test
    fun testNumbersWithAndWithoutQuotes() {
        // Movie A : nombres sans guillemets ; Movie B : nombres entre guillemets
        val movies = mediaDAO.addMoviesFrom("data/movies/2_movies.json")
        assertEquals(2000, movies[0].year)
        assertEquals(8.5, movies[0].imDbRating)
        assertEquals(2001, movies[1].year)
        assertEquals(7.5, movies[1].imDbRating)
    }

    @Test
    fun testUnknownKeysAreIgnored() {
        // les fichiers fournis contiennent de nombreuses clés inutilisées (image, rank, fullTitle...)
        assertEquals(2, mediaDAO.addMoviesFrom("data/movies/2_movies.json").size)
    }

    // ---- films et séries confondus ----

    @Test
    fun testSeriesFileLoadedAsMovies() {
        val movies = mediaDAO.addMoviesFrom("data/series/4_series.json")
        assertEquals(listOf("Breaking Bad", "Chernobyl", "The Wire", "The Sopranos"), movies.map { it.title })
    }

    @Test
    fun testMoviesFileLoadedAsSeries() {
        val series = mediaDAO.addSeriesFrom("data/movies/250_movies.json")
        assertEquals(250, series.size)
        assertEquals("tt0111161", series[0].id)
    }

    @Test
    fun testEpisodesFileLoadedAsSeriesFails() {
        assertThrows<JsonParserException> { mediaDAO.addSeriesFrom("data/series/episodes_from_1_serie.json") }
    }

    // ---- doublons ----

    @Test
    fun testSameSeriesFileTwice() {
        mediaDAO.addSeriesFrom("data/series/1_serie_with_episode.json")
        assertThrows<MediaException> { mediaDAO.addSeriesFrom("data/series/1_serie_with_episode.json") }
    }

    @Test
    fun testSeriesOverlappingFiles() {
        mediaDAO.addSeriesFrom("data/series/2_series_with_episodes.json") // Chernobyl, Sopranos
        assertThrows<MediaException> { mediaDAO.addSeriesFrom("data/series/4_series.json") }
    }

    @Test
    fun testSeriesDoublonAddsNothing() {
        mediaDAO.addSeriesFrom("data/series/1_serie_with_episode.json") // Chernobyl
        assertThrows<MediaException> { mediaDAO.addSeriesFrom("data/series/2_series_with_episodes.json") } // Chernobyl, Sopranos
        val series = mediaDAO.addSeriesFrom("data/series/2_series_without_episode.json")
        assertEquals(listOf("Chernobyl", "Breaking Bad", "The Wire"), series.map { it.title })
    }

    @Test
    fun testSeriesDoublonInsideOneFile() {
        assertThrows<MediaException> { mediaDAO.addSeriesFrom("data/series/2_series_with2same.json") }
    }

    @Test
    fun testSameMoviesFileTwice() {
        mediaDAO.addMoviesFrom("data/movies/250_movies.json")
        assertThrows<MediaException> { mediaDAO.addMoviesFrom("data/movies/250_movies.json") }
        assertEquals(250, mediaDAO.addMoviesFrom("data/series/4_series.json").size - 4)
    }

    @Test
    fun testMoviesDoublonInsideOneFile() {
        assertThrows<MediaException> { mediaDAO.addMoviesFrom("data/movies/2_movies_with2same.json") }
        assertEquals(2, mediaDAO.addMoviesFrom("data/movies/2_movies.json").size)
    }

    @Test
    fun testSameTitleDifferentYearIsNotADoublon() {
        mediaDAO.addMoviesFrom("data/movies/2_movies.json")
        val movies = mediaDAO.addMoviesFrom("data/movies/1_movie.json") // "Movie A" de 2010
        assertEquals(3, movies.size)
        assertEquals(2, movies.count { it.title == "Movie A" })
    }

    @Test
    fun testSameEpisodesFileTwice() {
        val series = mediaDAO.addSeriesFrom("data/series/1_serie_with_episode.json")
        mediaDAO.addEpisodesFrom("data/series/episodes_from_1_serie.json")
        assertThrows<EpisodeException> { mediaDAO.addEpisodesFrom("data/series/episodes_from_1_serie.json") }
        assertEquals(5, series[0].episodes.size)
    }

    @Test
    fun testEpisodesDoublonAddsNothing() {
        val series = mediaDAO.addSeriesFrom("data/series/1_serie_with_episode.json")
        assertThrows<EpisodeException> { mediaDAO.addEpisodesFrom("data/series/episodes_with2same.json") }
        assertTrue(series[0].episodes.isEmpty())
        assertEquals(5, mediaDAO.addEpisodesFrom("data/series/episodes_from_1_serie.json").size)
    }

    // ---- lien série <-> épisodes ----

    @Test
    fun testEpisodesAreAttachedToTheirSerie() {
        val series = mediaDAO.addSeriesFrom("data/series/4_series.json")
        mediaDAO.addEpisodesFrom("data/series/episodes_from_1_serie.json")

        val chernobyl = series.first { it.id == "tt7366338" }
        assertEquals(5, chernobyl.episodes.size)
        assertEquals(1, chernobyl.episodes[0].episodeNumber)
        assertTrue(series.filter { it.id != "tt7366338" }.all { it.episodes.isEmpty() })
    }

    @Test
    fun testSerieWithoutEpisodesHasEmptyList() {
        val series = mediaDAO.addSeriesFrom("data/series/4_series.json")
        assertTrue(series.all { it.episodes.isEmpty() })
    }
}
