import netprime.businesslayer.NetPrime
import netprime.businesslayer.iMediaRepository
import netprime.datalayer.MediaDAO
import netprime.datalayer.UserDAO
import netprime.datalayer.datamodel.medias.Episode
import netprime.datalayer.datamodel.medias.Movie
import netprime.datalayer.datamodel.medias.Serie
import netprime.exceptions.EpisodeException
import netprime.exceptions.JsonParserException
import netprime.exceptions.MediaException
import org.junit.jupiter.api.Assertions.*
import org.junit.jupiter.api.BeforeEach
import org.junit.jupiter.api.Test
import org.junit.jupiter.api.assertThrows
import java.io.FileNotFoundException

class TestUsageNetPrimeMedia {

    lateinit var netPrime: iMediaRepository

    private val chernobylEpisodes = listOf(
        "1:23:45", "Please Remain Calm", "Open Wide, O Earth",
        "The Happiness of All Mankind", "Vichnaya Pamyat"
    )

    @BeforeEach
    fun reinit() {
        netPrime = NetPrime(userDao = UserDAO(), mediaDAO = MediaDAO())
    }

    // ---- dépôt vide ----

    @Test
    fun testEmptyRepository() {
        assertEquals(0, netPrime.nbTotalMedias())
        assertEquals(0, netPrime.nbMovies())
        assertEquals(0, netPrime.nbSeries())
        assertTrue(netPrime.listAllMedias().isEmpty())
        assertFalse(netPrime.isSerieId("tt7366338"))
        assertTrue(netPrime.episodesFrom("Chernobyl").isEmpty())
        assertTrue(netPrime.listByTitleKeyword("Godfather").isEmpty())
        assertTrue(netPrime.listByCrew("Al Pacino").isEmpty())
    }

    // ---- chargement ----

    @Test
    fun testLoadMovies() {
        netPrime.loadMoviesFrom("data/movies/250_movies.json")
        assertEquals(250, netPrime.nbMovies())
        assertEquals(0, netPrime.nbSeries())
        assertEquals(250, netPrime.nbTotalMedias())
    }

    @Test
    fun testLoadSeries() {
        netPrime.loadSeriesFrom("data/series/4_series.json")
        assertEquals(0, netPrime.nbMovies())
        assertEquals(4, netPrime.nbSeries())
        assertEquals(4, netPrime.nbTotalMedias())
    }

    @Test
    fun testLoadMoviesAndSeries() {
        netPrime.loadMoviesFrom("data/movies/250_movies.json")
        netPrime.loadSeriesFrom("data/series/4_series.json")
        assertEquals(250, netPrime.nbMovies())
        assertEquals(4, netPrime.nbSeries())
        assertEquals(254, netPrime.nbTotalMedias())
    }

    @Test
    fun testLoadEpisodesCountInTotalOnly() {
        netPrime.loadSeriesFrom("data/series/4_series.json")
        netPrime.loadEpisodesFrom("data/series/episodes_from_1_serie.json")
        assertEquals(0, netPrime.nbMovies())
        assertEquals(4, netPrime.nbSeries())
        assertEquals(9, netPrime.nbTotalMedias())
    }

    @Test
    fun testLoadSeveralFiles() {
        netPrime.loadSeriesFrom("data/series/2_series_without_episode.json")
        netPrime.loadSeriesFrom("data/series/1_serie_with_episode.json")
        assertEquals(3, netPrime.nbSeries())

        netPrime.loadMoviesFrom("data/movies/2_movies.json")
        netPrime.loadMoviesFrom("data/movies/1_movie.json")
        assertEquals(3, netPrime.nbMovies())
        assertEquals(6, netPrime.nbTotalMedias())
    }

    @Test
    fun testLoadFileNotFound() {
        assertThrows<FileNotFoundException> { netPrime.loadMoviesFrom("data/movies/XXX.json") }
        assertThrows<FileNotFoundException> { netPrime.loadSeriesFrom("data/series/XXX.json") }
        assertThrows<FileNotFoundException> { netPrime.loadEpisodesFrom("data/series/XXX.json") }
        assertEquals(0, netPrime.nbTotalMedias())
    }

    @Test
    fun testLoadJsonParserException() {
        assertThrows<JsonParserException> { netPrime.loadMoviesFrom("data/movies/IMDb.md") }
        assertThrows<JsonParserException> { netPrime.loadSeriesFrom("data/movies/IMDb.md") }
        assertThrows<JsonParserException> { netPrime.loadEpisodesFrom("data/movies/IMDb.md") }
        assertEquals(0, netPrime.nbTotalMedias())
    }

    @Test
    fun testLoadEpisodesWithoutSerie() {
        assertThrows<EpisodeException> { netPrime.loadEpisodesFrom("data/series/episodes_from_1_serie.json") }
        assertEquals(0, netPrime.nbTotalMedias())
    }

    @Test
    fun testLoadDoublonKeepsRepositoryUnchanged() {
        netPrime.loadSeriesFrom("data/series/4_series.json")
        netPrime.loadMoviesFrom("data/movies/2_movies.json")

        assertThrows<MediaException> { netPrime.loadSeriesFrom("data/series/1_serie_with_episode.json") }
        assertThrows<MediaException> { netPrime.loadMoviesFrom("data/movies/2_movies.json") }
        assertEquals(4, netPrime.nbSeries())
        assertEquals(2, netPrime.nbMovies())
    }

    // ---- listAllMedias ----

    @Test
    fun testListAllMediasSortedByRatingThenTitle() {
        netPrime.loadSeriesFrom("data/series/4_series.json")
        // 9.2 Sopranos, 9.3 Chernobyl et The Wire (ordre alphabétique), 9.4 Breaking Bad
        assertEquals(
            listOf("The Sopranos", "Chernobyl", "The Wire", "Breaking Bad"),
            netPrime.listAllMedias()
        )
    }

    @Test
    fun testListAllMediasMoviesAndSeries() {
        netPrime.loadMoviesFrom("data/movies/250_movies.json")
        netPrime.loadSeriesFrom("data/series/4_series.json")

        val titles = netPrime.listAllMedias()
        assertEquals(254, titles.size)
        assertTrue(titles.indexOf("The Sopranos") < titles.indexOf("Chernobyl"))
        assertTrue(titles.indexOf("Chernobyl") < titles.indexOf("The Wire"))
        assertTrue(titles.indexOf("The Wire") < titles.indexOf("Breaking Bad"))
        assertTrue(titles.contains("The Godfather"))
    }

    @Test
    fun testListAllMediasIncludesEpisodes() {
        netPrime.loadSeriesFrom("data/series/1_serie_with_episode.json")
        netPrime.loadEpisodesFrom("data/series/episodes_from_1_serie.json")

        val titles = netPrime.listAllMedias()
        assertEquals(6, titles.size)
        assertEquals("Chernobyl", titles[0]) // 9.3 : la plus basse note
        assertEquals("Vichnaya Pamyat", titles.last()) // 9.8
    }

    // ---- isSerieId ----

    @Test
    fun testIsSerieId() {
        netPrime.loadSeriesFrom("data/series/4_series.json")
        assertTrue(netPrime.isSerieId("tt7366338"))
        assertTrue(netPrime.isSerieId("tt0903747"))
        assertFalse(netPrime.isSerieId("tt0000000"))
        assertFalse(netPrime.isSerieId(""))
    }

    @Test
    fun testIsSerieIdOfAMovie() {
        netPrime.loadMoviesFrom("data/movies/250_movies.json")
        netPrime.loadSeriesFrom("data/series/4_series.json")
        assertFalse(netPrime.isSerieId("tt0111161")) // The Shawshank Redemption
    }

    // ---- episodesFrom ----

    @Test
    fun testEpisodesFrom() {
        netPrime.loadSeriesFrom("data/series/4_series.json")
        netPrime.loadEpisodesFrom("data/series/episodes_from_1_serie.json")
        assertEquals(chernobylEpisodes, netPrime.episodesFrom("Chernobyl"))
    }

    @Test
    fun testEpisodesFromSerieWithoutEpisode() {
        netPrime.loadSeriesFrom("data/series/4_series.json")
        netPrime.loadEpisodesFrom("data/series/episodes_from_1_serie.json")
        assertTrue(netPrime.episodesFrom("The Wire").isEmpty())
    }

    @Test
    fun testEpisodesFromUnknownTitle() {
        netPrime.loadSeriesFrom("data/series/4_series.json")
        netPrime.loadEpisodesFrom("data/series/episodes_from_1_serie.json")
        assertTrue(netPrime.episodesFrom("Xxxxx").isEmpty())
        assertTrue(netPrime.episodesFrom("chernobyl").isEmpty()) // titre exact
        assertTrue(netPrime.episodesFrom("Chern").isEmpty())
    }

    @Test
    fun testEpisodesFromEpisodeTitleIsNotASerie() {
        netPrime.loadSeriesFrom("data/series/4_series.json")
        netPrime.loadEpisodesFrom("data/series/episodes_from_1_serie.json")
        assertTrue(netPrime.episodesFrom("Please Remain Calm").isEmpty())
    }

    @Test
    fun testEpisodesFromSeveralSeries() {
        netPrime.loadSeriesFrom("data/series/4_series.json")
        netPrime.loadEpisodesFrom("data/series/episodes_from_1_serie.json")
        netPrime.loadEpisodesFrom("data/series/episodes_from_other_serie.json")

        assertEquals(chernobylEpisodes, netPrime.episodesFrom("Chernobyl"))
        assertEquals(listOf("The Sopranos 1.1", "The Sopranos 1.2"), netPrime.episodesFrom("The Sopranos"))
    }

    // ---- listByTitleKeyword ----

    @Test
    fun testListByTitleKeywordSortedByYear() {
        netPrime.loadMoviesFrom("data/movies/250_movies.json")

        val result = netPrime.listByTitleKeyword("Godfather")
        assertEquals(listOf("The Godfather", "The Godfather Part II"), result.map { it.title })
        assertEquals(listOf(1972, 1974), result.map { it.year })
    }

    @Test
    fun testListByTitleKeywordSeveralMatches() {
        netPrime.loadMoviesFrom("data/movies/250_movies.json")

        val result = netPrime.listByTitleKeyword("Star")
        assertEquals(
            listOf(1977, 1980, 1983, 2007),
            result.map { it.year }
        )
        assertEquals("Like Stars on Earth", result.last().title)
    }

    @Test
    fun testListByTitleKeywordSameYearSortedByTitle() {
        netPrime.loadMoviesFrom("data/movies/250_movies.json")

        val result = netPrime.listByTitleKeyword("")
        assertEquals(250, result.size)
        assertEquals(
            result.sortedWith(compareBy({ it.year }, { it.title })).map { it.title },
            result.map { it.title }
        )
    }

    @Test
    fun testListByTitleKeywordMoviesAndSeries() {
        netPrime.loadMoviesFrom("data/movies/250_movies.json")
        netPrime.loadSeriesFrom("data/series/4_series.json")

        val result = netPrime.listByTitleKeyword("Chernobyl")
        assertEquals(1, result.size)
        assertTrue(result[0] is Serie)

        val wire = netPrime.listByTitleKeyword("Wire")
        assertTrue(wire.any { it is Serie && it.title == "The Wire" })
    }

    @Test
    fun testListByTitleKeywordNoMatch() {
        netPrime.loadMoviesFrom("data/movies/250_movies.json")
        assertTrue(netPrime.listByTitleKeyword("Xxxxx").isEmpty())
        assertTrue(netPrime.listByTitleKeyword("godfather").isEmpty()) // sensible à la casse
    }

    @Test
    fun testListByTitleKeywordSameTitleDifferentYears() {
        netPrime.loadMoviesFrom("data/movies/2_movies.json")
        netPrime.loadMoviesFrom("data/movies/1_movie.json")

        val result = netPrime.listByTitleKeyword("Movie A")
        assertEquals(listOf(2000, 2010), result.map { it.year })
    }

    // ---- listByCrew ----

    @Test
    fun testListByCrewSortedByTitle() {
        netPrime.loadMoviesFrom("data/movies/250_movies.json")

        val result = netPrime.listByCrew("Al Pacino")
        assertEquals(
            listOf("Heat", "Scarface", "The Godfather", "The Godfather Part II"),
            result.map { it.title }
        )
    }

    @Test
    fun testListByCrewDirector() {
        netPrime.loadMoviesFrom("data/movies/250_movies.json")

        val result = netPrime.listByCrew("Christopher Nolan")
        assertEquals(7, result.size)
        assertEquals("Batman Begins", result.first().title)
        assertEquals("The Prestige", result.last().title)
        assertTrue(result.all { it.crew.contains("Christopher Nolan") })
    }

    @Test
    fun testListByCrewSeries() {
        netPrime.loadMoviesFrom("data/movies/250_movies.json")
        netPrime.loadSeriesFrom("data/series/4_series.json")

        val result = netPrime.listByCrew("Bryan Cranston")
        assertEquals(1, result.size)
        assertEquals("Breaking Bad", result[0].title)
        assertTrue(result[0] is Serie)
    }

    @Test
    fun testListByCrewMoviesAndSeriesMixed() {
        netPrime.loadMoviesFrom("data/movies/250_movies.json")
        netPrime.loadSeriesFrom("data/series/250_series.json")

        val result = netPrime.listByCrew("Al Pacino")
        assertTrue(result.any { it is Movie })
        assertEquals(result.sortedWith(compareBy({ it.title }, { it.year })), result)
    }

    @Test
    fun testListByCrewNotFound() {
        netPrime.loadMoviesFrom("data/movies/250_movies.json")
        assertTrue(netPrime.listByCrew("Xxxxx Xxxxx").isEmpty())
    }

    @Test
    fun testListByCrewNeedsFullName() {
        netPrime.loadMoviesFrom("data/movies/250_movies.json")
        assertTrue(netPrime.listByCrew("Pacino").isEmpty())
        assertTrue(netPrime.listByCrew("Al").isEmpty())
        assertTrue(netPrime.listByCrew("al pacino").isEmpty())
    }

    @Test
    fun testListByCrewDoesNotReturnEpisodes() {
        netPrime.loadSeriesFrom("data/series/1_serie_with_episode.json")
        netPrime.loadEpisodesFrom("data/series/episodes_from_1_serie.json")
        assertEquals(1, netPrime.listByCrew("Jessie Buckley").size)
    }

    // ---- delete ----

    @Test
    fun testDeleteMovie() {
        netPrime.loadMoviesFrom("data/movies/250_movies.json")
        val shawshank = netPrime.listByTitleKeyword("Shawshank").first()

        netPrime.delete(shawshank)
        assertEquals(249, netPrime.nbMovies())
        assertEquals(249, netPrime.nbTotalMedias())
        assertTrue(netPrime.listByTitleKeyword("Shawshank").isEmpty())
        assertFalse(netPrime.listByCrew("Tim Robbins").any { it.title == "The Shawshank Redemption" })
        assertFalse(netPrime.listAllMedias().contains("The Shawshank Redemption"))
    }

    @Test
    fun testDeleteMovieWithAnEqualInstance() {
        netPrime.loadMoviesFrom("data/movies/250_movies.json")
        netPrime.delete(
            Movie("The Shawshank Redemption", 1994, "Frank Darabont (dir.), Tim Robbins, Morgan Freeman", 9.2)
        )
        assertEquals(249, netPrime.nbMovies())
    }

    @Test
    fun testDeleteMovieTwice() {
        netPrime.loadMoviesFrom("data/movies/250_movies.json")
        val shawshank = netPrime.listByTitleKeyword("Shawshank").first()

        netPrime.delete(shawshank)
        assertThrows<MediaException> { netPrime.delete(shawshank) }
        assertEquals(249, netPrime.nbMovies())
    }

    @Test
    fun testDeleteNotFound() {
        netPrime.loadMoviesFrom("data/movies/250_movies.json")
        assertThrows<MediaException> { netPrime.delete(Movie("Xxxxx", 2000, "Xxxxx", 5.0)) }
        assertEquals(250, netPrime.nbMovies())
    }

    @Test
    fun testDeleteEmptyRepository() {
        assertThrows<MediaException> { netPrime.delete(Movie("Xxxxx", 2000, "Xxxxx", 5.0)) }
    }

    @Test
    fun testDeleteSerieDeletesItsEpisodes() {
        netPrime.loadSeriesFrom("data/series/4_series.json")
        netPrime.loadEpisodesFrom("data/series/episodes_from_1_serie.json")
        val chernobyl = netPrime.listByTitleKeyword("Chernobyl").first { it is Serie }

        netPrime.delete(chernobyl)
        assertEquals(3, netPrime.nbSeries())
        assertEquals(3, netPrime.nbTotalMedias())
        assertFalse(netPrime.isSerieId("tt7366338"))
        assertTrue(netPrime.episodesFrom("Chernobyl").isEmpty())
    }

    @Test
    fun testDeleteSerieKeepsOthers() {
        netPrime.loadSeriesFrom("data/series/4_series.json")
        netPrime.loadEpisodesFrom("data/series/episodes_from_1_serie.json")
        netPrime.loadEpisodesFrom("data/series/episodes_from_other_serie.json")

        netPrime.delete(netPrime.listByTitleKeyword("Chernobyl").first())
        assertEquals(listOf("The Sopranos 1.1", "The Sopranos 1.2"), netPrime.episodesFrom("The Sopranos"))
        assertTrue(netPrime.isSerieId("tt0141842"))
    }

    @Test
    fun testDeleteEpisode() {
        netPrime.loadSeriesFrom("data/series/4_series.json")
        netPrime.loadEpisodesFrom("data/series/episodes_from_1_serie.json")

        netPrime.delete(Episode("tt7366338", "1:23:45", 2019, 9.4, 1, 1))
        assertEquals(chernobylEpisodes.drop(1), netPrime.episodesFrom("Chernobyl"))
        assertEquals(4, netPrime.nbSeries())
        assertEquals(8, netPrime.nbTotalMedias())
    }

    @Test
    fun testDeleteOneOfTwoMovies() {
        netPrime.loadMoviesFrom("data/movies/2_movies.json")
        netPrime.delete(netPrime.listByTitleKeyword("Movie A").first())
        assertEquals(1, netPrime.nbTotalMedias())
        assertEquals("Movie B", netPrime.listAllMedias()[0])
    }
}
